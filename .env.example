# Optional: where the contact / journey-request form POSTs its JSON payload.
# Works with Formspree, Netlify Forms, Web3Forms, or your own endpoint.
# When unset, the form falls back to opening the visitor's email client.
VITE_CONTACT_ENDPOINT=

# Optional: where the site looks up the visitor's country to pick a default
# language (English or French). It must return the two-letter country code,
# either as plain text or as JSON with a `country` / `country_code` field.
#
# Unset, the site uses https://get.geojs.io/v1/ip/country.json — free and
# key-less, but rate-limited and a third-party request.
#
# In production prefer your own host's geo header, which is faster, private and
# has no quota. On Vercel, an edge function at /api/country:
#   export const config = { runtime: 'edge' };
#   export default (req) =>
#     new Response(req.headers.get('x-vercel-ip-country') ?? '', {
#       headers: { 'content-type': 'text/plain' },
#     });
# then set:
#   VITE_GEO_ENDPOINT=/api/country
VITE_GEO_ENDPOINT=
